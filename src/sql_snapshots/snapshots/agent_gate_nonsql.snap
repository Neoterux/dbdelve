[mongodb] update many without a filter: db.c.updateMany({}, {$set: {a: 2}}) => |ro=refuse(NeedsMode { needed: ReadWrite, held: ReadOnly }) rw=approve(ReadWrite) full=approve(ReadWrite)|
[mongodb] replace one: db.c.replaceOne({a: 1}, {a: 2}) => |ro=refuse(NeedsMode { needed: ReadWrite, held: ReadOnly }) rw=approve(ReadWrite) full=approve(ReadWrite)|
