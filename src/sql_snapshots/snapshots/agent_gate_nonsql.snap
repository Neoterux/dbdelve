[mongodb] list indexes: db.c.getIndexes() => |ro=run rw=run full=run|
[mongodb] run a read command: db.runCommand({ping: 1}) => |ro=run rw=run full=run|
[mongodb] insert one: db.c.insertOne({a: 1}) => |ro=refuse(NeedsMode { needed: ReadWrite, held: ReadOnly }) rw=approve(ReadWrite) full=approve(ReadWrite)|
[mongodb] insert many: db.c.insertMany([{a: 1}]) => |ro=refuse(NeedsMode { needed: ReadWrite, held: ReadOnly }) rw=approve(ReadWrite) full=approve(ReadWrite)|
[mongodb] update one: db.c.updateOne({a: 1}, {$set: {a: 2}}) => |ro=refuse(NeedsMode { needed: ReadWrite, held: ReadOnly }) rw=approve(ReadWrite) full=approve(ReadWrite)|
